{
  "name": "courier-sestroretsk",
  "private": true,
  "version": "0.1.0",
  "description": "Аркадный симулятор курьера на реальной карте Сестрорецка (OpenStreetMap)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "map": "tsx scripts/build-map.ts",
    "map:test": "tsx scripts/build-test-map.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
